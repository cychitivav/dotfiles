# --- Terminal / shell -----------------------------------------------------------------------------
term = xterm-256color
shell-integration-features = sudo,no-ssh-terminfo,ssh-env

# --- Appearance -----------------------------------------------------------------------------------
theme = dark:"Adwaita Dark", light:"Adwaita"
font-family = "Fira Code"
background-opacity = 0.85
background-blur = true
mouse-hide-while-typing = true

# Dim unfocused splits so the active pane is easy to spot
unfocused-split-opacity = 0.5

# copy-on-select = clipboard

# --- Window / GTK ---------------------------------------------------------------------------------
# window-decoration = false
window-theme = ghostty

gtk-tabs-location = hidden
# gtk-toolbar-style = flat
gtk-titlebar-style = tabs
gtk-wide-tabs = false

# --- Keybinds -------------------------------------------------------------------------------------
# keybind = clear

# Split navigation: ctrl+shift + vim keys / arrows
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+j=goto_split:down
keybind = ctrl+shift+k=goto_split:up
keybind = ctrl+shift+l=goto_split:right

keybind = ctrl+shift+arrow_left=goto_split:left
keybind = ctrl+shift+arrow_down=goto_split:down
keybind = ctrl+shift+arrow_up=goto_split:up
keybind = ctrl+shift+arrow_right=goto_split:right

# Split resizing: alt+shift + vim keys / arrows
keybind = alt+shift+h=resize_split:left,10
keybind = alt+shift+j=resize_split:down,10
keybind = alt+shift+k=resize_split:up,10
keybind = alt+shift+l=resize_split:right,10

keybind = alt+shift+arrow_left=resize_split:left,10
keybind = alt+shift+arrow_down=resize_split:down,10
keybind = alt+shift+arrow_up=resize_split:up,10
keybind = alt+shift+arrow_right=resize_split:right,10

# Direct split shortcuts
keybind = ctrl+shift+e=new_split:down
keybind = ctrl+shift+d=new_split:right

# Tabs
keybind = ctrl+shift+s=toggle_tab_overview

# === Copy mode ===
keybind = ctrl+shift+z=activate_key_table:copy
keybind = copy/escape=deactivate_key_table
keybind = copy/q=deactivate_key_table
keybind = copy/catch_all=ignore

# Adjust selection
keybind = copy/h=adjust_selection:left
keybind = copy/j=adjust_selection:down
keybind = copy/k=adjust_selection:up
keybind = copy/l=adjust_selection:right

keybind = copy/arrow_left=adjust_selection:left
keybind = copy/arrow_down=adjust_selection:down
keybind = copy/arrow_up=adjust_selection:up
keybind = copy/arrow_right=adjust_selection:right

keybind = copy/home=adjust_selection:beginning_of_line
keybind = copy/end=adjust_selection:end_of_line

# Scroll by line
keybind = copy/ctrl+j=scroll_page_lines:1
keybind = copy/ctrl+k=scroll_page_lines:-1

keybind = copy/ctrl+arrow_down=scroll_page_lines:1
keybind = copy/ctrl+arrow_up=scroll_page_lines:-1

# Jump between prompts
keybind = copy/shift+j=jump_to_prompt:1
keybind = copy/shift+k=jump_to_prompt:-1
keybind = copy/shift+arrow_down=jump_to_prompt:1
keybind = copy/shift+arrow_up=jump_to_prompt:-1

# Scroll by page
keybind = copy/d=scroll_page_down
keybind = copy/u=scroll_page_up
keybind = copy/page_down=scroll_page_down
keybind = copy/page_up=scroll_page_up

# Top / bottom
keybind = copy/g=scroll_to_top
keybind = copy/shift+g=scroll_to_bottom

keybind = copy/ctrl+home=scroll_to_top
keybind = copy/ctrl+end=scroll_to_bottom

# Copy / paste
keybind = copy/ctrl+a=select_all
keybind = copy/o=write_scrollback_file:open
keybind = copy/s=write_screen_file:open
keybind = copy/p=write_scrollback_file:paste

